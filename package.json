{
    "name": "anri-ui",
    "version": "0.3.0",
    "private": true,
    "type": "module",
    "description": "Vue 3 component library with a Nuxt adapter.",
    "packageManager": "pnpm@11.10.0",
    "engines": {
        "node": ">=24"
    },
    "exports": {
        ".": {
            "types": "./src/index.ts",
            "import": "./src/index.ts"
        },
        "./nuxt": "./nuxt/module.mjs",
        "./style.css": "./styles/theme.css",
        "./package.json": "./package.json"
    },
    "files": [
        "src",
        "nuxt",
        "styles",
        "docs",
        "README.md"
    ],
    "scripts": {
        "lint": "oxlint src nuxt",
        "typecheck": "vue-tsc --noEmit -p tsconfig.json",
        "dev:vue": "pnpm -C playground dev",
        "dev:nuxt": "pnpm -C playground-nuxt dev",
        "build:vue": "pnpm -C playground build",
        "build:nuxt": "pnpm -C playground-nuxt build"
    },
    "peerDependencies": {
        "nuxt": "^4.0.0",
        "tailwindcss": "^4.0.0",
        "vue": "^3.5.0",
        "vue-router": "^4.0.0 || ^5.0.0"
    },
    "peerDependenciesMeta": {
        "nuxt": {
            "optional": true
        },
        "tailwindcss": {
            "optional": true
        }
    },
    "dependencies": {
        "@floating-ui/vue": "^1.1.11",
        "@heroicons/vue": "^2.2.0",
        "@nuxt/kit": "^4.5.2"
    },
    "devDependencies": {
        "oxlint": "^1.79.0",
        "prettier": "^3.9.6",
        "typescript": "^6.0.3",
        "vue": "^3.5.41",
        "vue-router": "^5.2.0",
        "vue-tsc": "^3.3.11"
    }
}
